root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Match .gitattributes: PowerShell is CRLF, so editors must not fight Git over it.
[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab
