* text=auto eol=lf
*.py        text eol=lf diff=python
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
*.fish      text eol=lf
# PowerShell ships CRLF (Microsoft's own modules and sample scripts are CRLF).
# -text, not "text eol=crlf": the latter stores LF and only converts on checkout,
# so a raw download from the web UI would hand a Windows user an LF file. Storing
# the bytes verbatim keeps CRLF in every delivery path. Git still diffs it as text;
# -text disables conversion only, not diffing.
*.ps1       -text -eol
Makefile    text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf

# GitHub language stats: this is a documentation repo, so count the Markdown
# (prose is excluded by default) instead of the site tooling around it.
*.md linguist-detectable
